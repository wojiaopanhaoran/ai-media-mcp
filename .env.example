# ============ ai-media-mcp Configuration ============
# All variables are OPTIONAL. If a group variable is absent, it falls back to
# AI_MEDIA_API_KEY / AI_MEDIA_BASE_URL (single-gateway mode).
# If a group key is explicitly present but empty, that group is disabled and
# will NOT reuse another provider's key (for example Jimeng below).

# --- Unified gateway (fallback for all groups) ---
AI_MEDIA_API_KEY=sk-your-unified-key
AI_MEDIA_BASE_URL=https://your-gateway.com/v1

# --- GPT group (gpt-image-2 / doubao-seedream / jimeng image) ---
AI_MEDIA_GPT_API_KEY=sk-gpt-key
AI_MEDIA_GPT_BASE_URL=https://your-gateway.com/v1

# --- Gemini group (native Gemini API: gemini-3-pro-image etc.) ---
AI_MEDIA_GEMINI_API_KEY=sk-gemini-key
AI_MEDIA_GEMINI_BASE_URL=https://your-gateway.com/v1/beta

# --- Grok group (grok-imagine-image-quality / grok-imagine-video) ---
AI_MEDIA_GROK_API_KEY=sk-grok-key
AI_MEDIA_GROK_BASE_URL=https://your-gateway.com/v1

# --- Jimeng group (as-sd2.0-fast / video-ds-2.0, image & video) ---
AI_MEDIA_JIMENG_API_KEY=
AI_MEDIA_JIMENG_BASE_URL=https://your-gateway.com/v1

# --- Defaults ---
AI_MEDIA_IMAGE_MODEL=gpt-image-2
AI_MEDIA_VIDEO_MODEL=grok-imagine-video
AI_MEDIA_IMAGE_OUTPUT_DIR=D:\AI图片
AI_MEDIA_VIDEO_OUTPUT_DIR=D:\AI视频

# --- Auto prompt enhancement (auto_prompt; "never" disables globally) ---
AI_MEDIA_AUTO_PROMPT=auto

# --- Timeouts (ms) ---
AI_MEDIA_POLL_INTERVAL_MS=5000
AI_MEDIA_TIMEOUT_MS=900000

# --- Return mode: path | inline | both (path = zero base64, recommended) ---
AI_MEDIA_RETURN_MODE=path
